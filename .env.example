# Zenifra AI (create the key and choose the model in the Zenifra console)
ZENIFRA_AI_BASE_URL=https://ai.zenifra.com/v1
ZENIFRA_AI_API_KEY=replace-with-a-fake-local-value
ZENIFRA_AI_MODEL=replace-with-an-enabled-model

# SMTP (use a provider-specific app password where applicable)
SMTP_HOST=smtp.example.test
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USERNAME=sender@example.test
SMTP_PASSWORD=replace-with-a-fake-local-value
SMTP_FROM=sender@example.test
EMAIL_TO=receiver@example.test

# Runtime
PORT=8080
SCHEDULE_TIME=08:00
LEARNING_MORNING_TIME=07:00
LEARNING_EVENING_TIME=18:00
# Optional comma-separated override; defaults cover math, computing, systems, databases, algorithms and physics.
# Domínios conceituais; a LLM escolhe um assunto concreto dentro de cada domínio.
# LEARNING_TOPICS=matemática,história da matemática,computação,Go,estruturas de dados e algoritmos,PostgreSQL,bancos de dados,sistemas operacionais,física
TIMEZONE=America/Sao_Paulo
TOP_STORIES=10
SQLITE_PATH=/data/daily-digest-news.sqlite3
LEARNING_RETENTION_DAYS=365
